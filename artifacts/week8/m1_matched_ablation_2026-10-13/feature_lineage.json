  "blocks": {
    "G1": "B2 generic pilot statistics",
    "G2": "OEH-B summaries of the row's learner",
    "G3": "OEH-B posterior concentrations",
    "G4": "OEH-H descriptors and ceilings",
    "G5": "OEH-H risk and missing-mass profile",
