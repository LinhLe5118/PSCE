  "components": {
    "b2_statistics": {
      "producer": "code/stochastic_features.py::extract_stochastic_features",
      "inputs": [
        "pilot_x10",
        "public_S_A",
        "gamma_0.95"
      ],
      "note": "200 trajectory-bootstrap replicates; one call per (MDP, behavior)"
    },
    "oeh3_risk": {
      "producer": "code/oeh_risk_v3.py::estimate_oeh_risk_v3 + code/stochastic_features.py::aggregate_oeh_risk_v3_profile",
      "inputs": [
        "pilot_x10",
        "public_S_A",
        "public_rho",
        "gamma_0.95"
      ],
      "note": "k_max=100; learner-agnostic; one call per (MDP, behavior)"
    },
    "lcoeh4_crossfit": {
      "producer": "code/lcoeh_v4.py::estimate_lcoeh_v4",
      "inputs": [
        "pilot_prefix_x2",
        "pilot_prefix_x5",
        "pilot_x10",
        "public_S_A",
        "public_rho",
        "gamma_0.95",
        "learner_code_BC_CFQI_IQL"
      ],
      "note": "trains each core learner on 4/5 of the pilot trajectories at three nested prefixes; one call returns all three learners"
    },
    "posterior_fit": {
      "producer": "code/oeh/posterior.py::pilot_statistics + fit_posterior",
      "inputs": [
        "pilot_x10",
        "public_S_A",
        "public_rho",
        "gamma_0.95",
        "structure_A2"
      ],
      "note": "empirical-Bayes Dirichlet concentrations; also a prerequisite of OEH-H"
    },
    "oehb_simulation": {
      "producer": "code/oeh/predictive.py::posterior_outcomes + requirement_forecast (scripts/analysis/run_oeh_final_120.py::oeh_b_group)",
      "inputs": [
        "posterior_fit",
        "learner_code_BC_CFQI_IQL",
        "64_posterior_draws",
        "6_budgets_x_10_seeds"
      ],
      "note": "replays the three core learners on simulated nested streams; one call per (MDP, behavior)"
    },
    "oehh_horizon": {
      "producer": "code/oeh/horizon.py::offline_effective_horizon(form=risk) + offline_theory_measures + asymptotic_ceilings + risk_profile on scripts/analysis/develop_oeh_horizon.py::posterior_mean_model (scripts/analysis/run_oeh_final_120.py::horizon_group)",
      "inputs": [
        "posterior_fit",
        "pilot_x10_observed_mask",
        "public_rho",
        "gamma_0.95",
        "tau_0.95",
        "horizon_100"
      ],
      "note": "posterior-mean model only, no learner replay; one call per (MDP, behavior)"
    }
  },
  "component_requires": {
    "oehb_simulation": [
      "posterior_fit"
    ],
    "oehh_horizon": [
      "posterior_fit"
    ]
